# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=taskmgmt
DB_PASSWORD=replace_with_app_database_password
DB_NAME=taskmgmt
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

# JWT authentication
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# SMTP email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password_or_app_token
SMTP_FROM="Taskmgmt <no-reply@example.com>"

# Due-task notification schedule (every five minutes)
DUE_NOTIFICATION_CRON=*/5 * * * *